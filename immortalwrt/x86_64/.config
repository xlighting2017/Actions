# vi: set syntax=make:

#####################################################################
# Target platform
#####################################################################
CONFIG_TARGET_x86=y

#####################################################################
# Target device
#####################################################################
# Uncomment target device you want to build for, set '=y'
CONFIG_TARGET_x86_64=y

CONFIG_TARGET_ROOTFS_PARTSIZE=500
CONFIG_GRUB_IMAGES=y
CONFIG_ISO_IMAGES=y
CONFIG_QCOW2_IMAGES=y
CONFIG_VDI_IMAGES=y
CONFIG_VHDX_IMAGES=y
CONFIG_VMDK_IMAGES=y

# Uncomment target device you want to build for, set '=y'
CONFIG_TARGET_DEVICE_x86_64_DEVICE_generic=y
CONFIG_TARGET_DEVICE_PACKAGES_x86_64_DEVICE_generic=""

#
# Image Options
#
# enable Image options (package/base-files/image-config.in)
CONFIG_IMAGEOPT=y
# enable PREINIT options
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_IP="192.168.199.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.199.255"
# set default lan IP
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
# enable Version Naming on filenames
# CONFIG_VERSIONOPT=y
# CONFIG_VERSION_FILENAMES=y
# CONFIG_VERSION_CODE_FILENAMES=y
# CONFIG_TARGET_ROOTFS_PERSIST_VAR is not set
# end of Target Images
