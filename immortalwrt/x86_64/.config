########################################
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y

########################################
# Target Devices
########################################
CONFIG_TARGET_DEVICE_x86_64_DEVICE_generic=y
CONFIG_TARGET_DEVICE_PACKAGES_x86_64_DEVICE_generic=""

CONFIG_TARGET_OPTIMIZATION="-Os -pipe"
CONFIG_EXTRA_OPTIMIZATION="-fno-caller-saves -fno-plt"

########################################
# Root filesystem images
########################################
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS=y

# x64 only
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_ISO_IMAGES=y
CONFIG_QCOW2_IMAGES=y
CONFIG_VDI_IMAGES=y
CONFIG_VMDK_IMAGES=y
CONFIG_VHDX_IMAGES=y

########################################
# Image Options
########################################
# x64 only
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=500

# LLVM & BPF
CONFIG_COLLECT_KERNEL_DEBUG=y
CONFIG_DWARVES=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_FTRACE=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_MODULE_ALLOW_BTF_MISMATCH=y
CONFIG_KERNEL_NETKIT=y
CONFIG_KERNEL_PERF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_REPRODUCIBLE_DEBUG_INFO=y


# CONFIG_BPF_TOOLCHAIN_NONE is not set
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_USE_LLVM_HOST=y
# CONFIG_BPF_TOOLCHAIN_BUILD_LLVM is not set
CONFIG_HAS_BPF_TOOLCHAIN=y
# CONFIG_HAS_PREBUILT_LLVM_TOOLCHAIN is not set

#
# Image Options
#
# enable Image options (package/base-files/image-config.in)
CONFIG_IMAGEOPT=y
# enable PREINIT options
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_IP="192.168.199.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.199.255"
# set default lan IP
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
# enable Version Naming on filenames
# CONFIG_VERSIONOPT=y
# CONFIG_VERSION_FILENAMES=y
# CONFIG_VERSION_CODE_FILENAMES=y
# end of Target Images


########################################
# Boot Loaders (x64 only)
########################################
# CONFIG_PACKAGE_gnu-efi-programs is not set
CONFIG_PACKAGE_grub2=y
CONFIG_PACKAGE_grub2-efi=y
# CONFIG_PACKAGE_gummiboot is not set

# CONFIG_PACKAGE_dumpimage is not set
# CONFIG_PACKAGE_fconfig is not set
# CONFIG_PACKAGE_fit-check-sign is not set
CONFIG_PACKAGE_grub2-bios-setup=y
# CONFIG_PACKAGE_grub2-editenv is not set
CONFIG_PACKAGE_uboot-envtools=y
# end of Boot Loaders

########################################
# Filesystems
########################################
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
# CONFIG_PACKAGE_kmod-fs-squashfs is not set
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fuse=y
CONFIG_PACKAGE_kmod-pstore=y
# end of Filesystems

########################################
# Other modules
########################################
CONFIG_PACKAGE_kmod-mtd-rw=n

########################################
# USB Support
########################################
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-dwc2=y
# CONFIG_PACKAGE_kmod-usb-dwc2-pci is not set
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-hid=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
# CONFIG_PACKAGE_kmod-usb-net-rtl8152 is not set
CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor=y
CONFIG_PACKAGE_kmod-usb-ohci=y
# CONFIG_PACKAGE_kmod-usb-ohci-pci is not set
CONFIG_PACKAGE_kmod-usb-roles=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
# CONFIG_PACKAGE_kmod-usb-xhci-pci-renesas is not set
CONFIG_PACKAGE_kmod-usb2=y
# CONFIG_PACKAGE_kmod-usb2-pci is not set
CONFIG_PACKAGE_kmod-usb3=y
# end of USB Support


CONFIG_OPENSSL_WITH_SSE2=y
CONFIG_PACKAGE_lm-sensors=y

########################################
# 3. LUCI Applications
########################################
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y

CONFIG_PACKAGE_luci-app-openclash=y

CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_luci-i18n-tailscale-community-zh-cn=y

CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y

# end of 3. Applications