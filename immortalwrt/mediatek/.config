# vi: set syntax=make:

#####################################################################
# Target platform
#####################################################################
CONFIG_TARGET_mediatek=y

#####################################################################
# Target device
#####################################################################
# Uncomment target device you want to build for, set '=y'
CONFIG_TARGET_mediatek_filogic=y

CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_bananapi_bpi-r3-mini=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_bananapi_bpi-r3-mini="luci-proto-quectel luci-app-qmodem-next luci-i18n-qmodem-next-zh-cn luci-app-mosdns luci-i18n-mosdns-zh-cn"

CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_jdcloud_re-cp-03=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_jdcloud_re-cp-03="luci-app-mosdns luci-i18n-mosdns-zh-cn"

CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_qihoo_360t7=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_qihoo_360t7="-luci-app-mosdns -luci-i18n-mosdns-zh-cn -mosdns -v2ray-geoip -v2ray-geosite -v2dat -geo2txt"

CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_ruijie_rg-x60=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_ruijie_rg-x60="-luci-app-mosdns -luci-i18n-mosdns-zh-cn -mosdns -v2ray-geoip -v2ray-geosite -v2dat -geo2txt"

#####################################################################
# Kernel build options
#####################################################################
#
# Image Options
#
# enable Image options (package/base-files/image-config.in)
CONFIG_IMAGEOPT=y
# enable PREINIT options
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_IP="192.168.199.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.199.255"
# set default lan IP
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
# enable Version Naming on filenames
CONFIG_VERSIONOPT=y
CONFIG_VERSION_FILENAMES=y
CONFIG_VERSION_CODE_FILENAMES=y
# CONFIG_TARGET_ROOTFS_PERSIST_VAR is not set
# end of Target Images

## enable testing kernel
# CONFIG_TESTING_KERNEL=y

#####################################################################
# Compiler Optimization
#####################################################################
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53+crc+crypto"

# Kernel Config
CONFIG_KERNEL_ARM_PMU=y
CONFIG_KERNEL_ARM_PMUV3=y

#####################################################################
# Feeds Configuration
#####################################################################
# Prevent package manager from adding custom feeds as repositories in final image.
# They don't exist upstream and will cause errors when trying to update
CONFIG_FEED_wwan=n
CONFIG_FEED_qmodem=n

# --- Essential Packages --- #

# --- Optional Packages --- #

#### EVERYTHING BELOW THIS SECTION IS OPTIONAL!!

#### You can delete or comment out with '#' any package you don't want to install.

#####################################################################
# Packages Tweaks
#####################################################################

#CONFIG_PACKAGE_cpufreq is not set

# eMMC support
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_cgdisk=y
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_mmc-utils=y
CONFIG_PACKAGE_sfdisk=y
CONFIG_PACKAGE_sgdisk=y

#####################################################################
# LuCI
#####################################################################


#####################################################################
# LUCI Applications
#####################################################################
# CONFIG_PACKAGE_luci-app-cpufreq is not set
# CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn is not set
CONFIG_PACKAGE_luci-app-mosdns=m
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=m

#####################################################################
# WWAN support
# Ref:  https://blog.siriling.com:1212/2023/03/18/openwrt-5g-modem/
#       
#####################################################################
# Common Dongles/Cards
# For USB mode
# 移远通信/quectel 	RG200U-CN（DONGLE版），RM500U-CN，RM500Q-GL
# 广和通/Fibocom 	FM650-CN，FM150-AE-01，FM150-AE-11，FM150-AE-21，FM150-NA-01，FM350-GL
# 美格智能/Meig 	SRM815，SRM825
# For PCIE mode
# 移远通信/quectel 	RG200U-CN（MINIPCIE版），RM500U-CN，RM500Q-GL
# 广和通/Fibocom 	FM150-AE-00，FM150-AE-10，FM150-AE-20，FM150-NA-00，FM350-GL
# Dial mode
# 拨号模式信息汇总
# 端口模式 	 拨号模式 	    依赖和驱动支持 	    拨号方式
# RMNET 	QMI，GobiNet 	驱动，拨号工具 	路由器拨号
# ECM 	    ECM 	        驱动 	        模组拨号
# MBIM 	    MBIM 	        驱动，拨号工具 	路由器拨号
# RNDIS 	RNDIS 	        驱动 	        模组拨号
# NCM 	    NCM 	        驱动 	        模组拨号


# Currently have: Fibocom/广和通 FM150-AE-01  
# USB Mode
# RMNET，ECM，MBIM，RNDIS，NCM


