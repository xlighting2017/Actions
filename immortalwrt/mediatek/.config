#####################################################################
# WWAN packages
# Ref:  https://github.com/immortalwrt/wwan-packages
#####################################################################

# Drivers
#
# Kernel PCIe driver for SPRD device, quectel-sprd-pcie
# CONFIG_PACKAGE_kmod-sprd-pcie=m
# Kernel PCIe driver for MHI device, quectel-mhi-pcie
# CONFIG_PACKAGE_kmod-mhi-pcie=m
# Gobinet driver for Quectel modules, quectel-gobinet
# CONFIG_PACKAGE_kmod-usb-net-gobinet=m
# QMI WWAN driver for Fibocom modules, fibocom-qmi-wwan
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan-fibocom=m
# QMI WWAN driver for Quectel modules, quectel-qmi-wwan
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan-quectel=m

# Utils (Dial, sms/ussd, AT, etc)
#
# Dialing tool for Fibocom WWAN modules, fibocom-dial
# CONFIG_PACKAGE_fibocom-dial=m
# Setting LTE/5G bands for selected modems, modemband
# CONFIG_PACKAGE_modemband=m
# Qconnector Manager for Quectel WWAN modules, quectel-cm
# CONFIG_PACKAGE_quectel-cm=m

# App (Luci, etc)
#
# LuCI JS interface for the 3ginfo-lite. The package allows you to view the parameters of the mobile internet connection.
# CONFIG_PACKAGE_luci-app-3ginfo-lite=m
# LuCI JS interface for the modemband. The package allows set LTE/5G bands for selected 4G/5G modems.
# CONFIG_PACKAGE_luci-app-modemband=m
# LuCI JS interface for the sms-tool. The user interface supports SMS / USSD Codes / AT Commands.
# CONFIG_PACKAGE_luci-app-sms-tool-js=m
# Support for Quectel WWAN modules
CONFIG_PACKAGE_luci-proto-quectel=m

#####################################################################
# QModem packages
# Ref:  https://github.com/FUjr/modem_feeds
#####################################################################
# luci-app-qmodem-next
CONFIG_PACKAGE_luci-app-qmodem-next=m
CONFIG_PACKAGE_luci-i18n-qmodem-next-zh-cn=m

# LuCI JS interface for the QModem.
# CONFIG_PACKAGE_qmodem-luci-ui is not set

### IPv6 Neighbor Discovery Selection
# "Include ndisc6 for IPv6 Neighbor Discovery"
CONFIG_PACKAGE_qmodem_INCLUDE_ndisc6=y
# "Include rdisc6 for IPv6 Router Discovery"
# CONFIG_PACKAGE_qmodem_INCLUDE_rdisc6 is not set
# "Do not include any IPv6 Neighbor/Router Discovery tool"
# CONFIG_PACKAGE_qmodem_INCLUDE_no_ndisc_rdisc6 is not set

### "Qualcomm QMI WWAN Driver Selection"
## Vendor QMI driver
# CONFIG_PACKAGE_qmodem_INCLUDE_vendor-qmi-wwan=y
## Generic QMI driver
CONFIG_PACKAGE_qmodem_INCLUDE_generic-qmi-wwan=y
## "NSS QMI driver"
## depends on TARGET_qualcommax_ipq807x || TARGET_qualcommax_ipq50xx
# CONFIG_PACKAGE_qmodem_INCLUDE_nss-qmi-wwan is not set

## Quectel Connect Manager Selection
# "Tom customized Quectel CM"
CONFIG_PACKAGE_qmodem_USE_TOM_CUSTOMIZED_QUECTEL_CM=y
# "QWRT Quectel-CM-5G"
# CONFIG_PACKAGE_qmodem_USING_QWRT_QUECTEL_CM_5G is not set
# "NORMAL Quectel-CM"
# CONFIG_PACKAGE_qmodem_USING_NORMAL_QUECTEL_CM is not set

## Add PCIe Modem SUPPORT
# CONFIG_PACKAGE_qmodem_INCLUDE_ADD_PCI_SUPPORT is not set
## Add MTK-T7XX Modem PCI SUPPORT
# CONFIG_PACKAGE_qmodem_INCLUDE_ADD_MTK_T7XX_SUPPORT is not set
## Add Qfirehose SUPPORT
# CONFIG_PACKAGE_qmodem_INCLUDE_ADD_QFIREHOSE_SUPPORT is not set

### "MHI PCIe Modem Driver Selection"
## "Use Vendor MHI PCIe Driver"
## depends on PACKAGE_qmodem_INCLUDE_ADD_PCI_SUPPORT
# CONFIG_PACKAGE_qmodem_VENDOR_MHI_PCIe_DRIVER=y

## "Use Generic MHI PCIe Driver"
# CONFIG_PACKAGE_qmodem_GENERIC_MHI_PCIe_DRIVER is not set

## "Use NSS MHI PCIe Driver"
## depends on TARGET_qualcommax_ipq807x || TARGET_qualcommax_ipq50xx
