# vi: set syntax=make:

#####################################################################
# Target platform
#####################################################################
CONFIG_TARGET_sunxi=y

#####################################################################
# Target device
#####################################################################
# Uncomment target device you want to build for, set '=y'
CONFIG_TARGET_sunxi_cortexa53=y

CONFIG_TARGET_ROOTFS_PARTSIZE=300

# Uncomment target device you want to build for, set '=y'
CONFIG_TARGET_DEVICE_sunxi_cortexa53_DEVICE_friendlyarm_nanopi-neo2=y
CONFIG_TARGET_DEVICE_PACKAGES_sunxi_cortexa53_DEVICE_friendlyarm_nanopi-neo2=""
CONFIG_TARGET_DEVICE_sunxi_cortexa53_DEVICE_friendlyarm_nanopi-r1s-h5=y
CONFIG_TARGET_DEVICE_PACKAGES_sunxi_cortexa53_DEVICE_friendlyarm_nanopi-r1s-h5="luci-i18n-cpufreq-zh-cn luci-app-cpufreq"
CONFIG_TARGET_DEVICE_sunxi_cortexa53_DEVICE_xunlong_orangepi-zero-plus=y
CONFIG_TARGET_DEVICE_PACKAGES_sunxi_cortexa53_DEVICE_xunlong_orangepi-zero-plus=""
CONFIG_TARGET_DEVICE_sunxi_cortexa53_DEVICE_xunlong_orangepi-zero3=y
CONFIG_TARGET_DEVICE_PACKAGES_sunxi_cortexa53_DEVICE_xunlong_orangepi-zero3="luci-i18n-cpufreq-zh-cn luci-app-cpufreq"
#
# Image Options
#
# enable Image options (package/base-files/image-config.in)
CONFIG_IMAGEOPT=y
# enable PREINIT options
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_IP="192.168.99.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.99.255"
# set default lan IP
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
# enable Version Naming on filenames
CONFIG_VERSIONOPT=y
CONFIG_VERSION_FILENAMES=y
CONFIG_VERSION_CODE_FILENAMES=y
# CONFIG_TARGET_ROOTFS_PERSIST_VAR is not set
# end of Target Images

#####################################################################
# Kernel build options
#####################################################################
## enable testing kernel
# CONFIG_TESTING_KERNEL=y

#####################################################################
# Compiler Optimization
#####################################################################
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53+crc+crypto"

# Kernel Config
CONFIG_KERNEL_ARM_PMU=y
CONFIG_KERNEL_ARM_PMUV3=y

#####################################################################
# Wireless Configuration
#####################################################################

#####################################################################
# Library Optimization
#####################################################################

# --- Essential Packages ---

#####################################################################
# LUCI (the web interface)
#####################################################################

#####################################################################
# LUCI Applications
#####################################################################

# --- Optional Packages --- #

#### EVERYTHING BELOW THIS SECTION IS OPTIONAL!!

#### You can delete or comment out with '#' any package you don't want to install.

#####################################################################
# Packages
#####################################################################
# CONFIG_PACKAGE_wifi-scripts is not set
# CONFIG_WIFI_SCRIPTS_UCODE is not set

#####################################################################
# Packages Tweaks
#####################################################################
# CONFIG_PACKAGE_libiwinfo-data is not set
# CONFIG_PACKAGE_wireless-regdb is not set

CONFIG_PACKAGE_cpufreq=m

#####################################################################
# LuCI
#####################################################################


#####################################################################
# LUCI Applications
#####################################################################
# cpufreq is only supported by R1S-H5
# Ref: https://web.git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/tree/arch/arm64/boot/dts/allwinner/sun50i-h5-nanopi-r1s-h5.dts?h=v6.6.83
CONFIG_PACKAGE_luci-app-cpufreq=m
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=m
