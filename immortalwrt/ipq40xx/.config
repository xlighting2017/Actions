# vi: set syntax=make:

#####################################################################
# Target platform
#####################################################################
CONFIG_TARGET_ipq40xx=y

#####################################################################
# Target device
#####################################################################
# Uncomment target device you want to build for, set '=y'
CONFIG_TARGET_ipq40xx_generic=y

# Uncomment target device you want to build for, set '=y'
CONFIG_TARGET_DEVICE_ipq40xx_generic_DEVICE_asus_rt-ac42u=y
CONFIG_TARGET_DEVICE_PACKAGES_ipq40xx_generic_DEVICE_asus_rt-ac42u=""

#####################################################################
# Kernel build options
#####################################################################
#
# Image Options
#
# enable Image options (package/base-files/image-config.in)
CONFIG_IMAGEOPT=y
# enable PREINIT options
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_IP="192.168.199.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.199.255"
# set default lan IP
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
# enable Version Naming on filenames
CONFIG_VERSIONOPT=y
CONFIG_VERSION_FILENAMES=y
CONFIG_VERSION_CODE_FILENAMES=y
# CONFIG_TARGET_ROOTFS_PERSIST_VAR is not set
# end of Target Images

## enable testing kernel
# CONFIG_TESTING_KERNEL=y

#####################################################################
# Compiler Optimization
#####################################################################
# ipq40xx is not A53
# CONFIG_TARGET_OPTIONS is not set
# CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53+crc+crypto"
# CONFIG_USE_GC_SECTIONS=y
CONFIG_PKG_DT_RELR=n

#####################################################################
# Packages Tweaks
#####################################################################
CONFIG_PACKAGE_cpufreq=n

#####################################################################
# LUCI Applications
#####################################################################
CONFIG_PACKAGE_luci-app-cpufreq=n
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=n

CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y

CONFIG_PACKAGE_luci-app-mosdns=n
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=n

CONFIG_PACKAGE_luci-app-openclash=n

CONFIG_PACKAGE_luci-app-tailscale-community=n
CONFIG_PACKAGE_luci-i18n-tailscale-community-zh-cn=n