# vi: set syntax=make:

#####################################################################
# Target platform
#####################################################################
CONFIG_TARGET_armsr=y

#####################################################################
# Target device
#####################################################################
# Uncomment target device you want to build for, set '=y'
CONFIG_TARGET_armsr_armv8=y

# Uncomment target device you want to build for, set '=y'
CONFIG_TARGET_DEVICE_armsr_armv8_DEVICE_generic=y
CONFIG_TARGET_DEVICE_PACKAGES_armsr_armv8_DEVICE_generic=""

# partition size
CONFIG_TARGET_KERNEL_PARTSIZE=128
CONFIG_TARGET_ROOTFS_PARTSIZE=512

#####################################################################
# Kernel build options
#####################################################################
#
# Target Images
#
CONFIG_TARGET_ROOTFS_INITRAMFS=y

#
# Root filesystem archives
#
CONFIG_TARGET_ROOTFS_TARGZ=y

#
# Root filesystem images
#
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y

CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y
CONFIG_TARGET_UBIFS_JOURNAL_SIZE=""
CONFIG_TARGET_SERIAL="ttyS0"

# gzip and more image formats
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_QCOW2_IMAGES=y
CONFIG_VMDK_IMAGES=y
#
# Image Options
#
# enable Image options (package/base-files/image-config.in)
CONFIG_IMAGEOPT=y
# enable PREINIT options
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_IP="192.168.199.253"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.199.255"
# set default lan IP
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
# enable Version Naming on filenames
# CONFIG_VERSIONOPT=y
# CONFIG_VERSION_FILENAMES=y
# CONFIG_VERSION_CODE_FILENAMES=y
# CONFIG_TARGET_ROOTFS_PERSIST_VAR is not set
# end of Target Images

## enable testing kernel
# CONFIG_TESTING_KERNEL=y

#####################################################################
# Package build options
#####################################################################
# CONFIG_DEBUG is not set
# CONFIG_USE_GC_SECTIONS is not set
# CONFIG_USE_LTO is not set
CONFIG_MOLD=y
# CONFIG_USE_MOLD is not set
CONFIG_IPV6=y

#####################################################################
# Compiler Optimization
#####################################################################
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53+crc+crypto"
# CONFIG_USE_GC_SECTIONS=y

# Kernel Config
CONFIG_KERNEL_ARM_PMU=y
CONFIG_KERNEL_ARM_PMUV3=y

#####################################################################
# Wireless Configuration
#####################################################################
#
# Wireless Drivers
#
CONFIG_PACKAGE_kmod-brcmfmac=y
CONFIG_PACKAGE_kmod-brcmutil=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y

#####################################################################
# Library Optimization
#####################################################################
# Optimize common libraries (zlib, zstd) for speed, improving performance on compression tasks.
CONFIG_ZLIB_OPTIMIZE_SPEED=y
CONFIG_ZSTD_OPTIMIZE_O3=y

# --- Essential Packages ---
# !!! below are the packages needed for Packit/amlogic only !!!
#####################################################################
# Languages
#####################################################################
#
# Perl
#
CONFIG_PACKAGE_perl=y
CONFIG_PACKAGE_perl-http-date=y
CONFIG_PACKAGE_perlbase-file=y
CONFIG_PACKAGE_perlbase-getopt=y
CONFIG_PACKAGE_perlbase-time=y
CONFIG_PACKAGE_perlbase-unicode=y
CONFIG_PACKAGE_perlbase-utf8=y
# end of Perl
# end of Languages

#####################################################################
# Packages
#####################################################################
#
# Utilities
#
#
# Compression
#
CONFIG_PACKAGE_bsdtar=y
CONFIG_PACKAGE_pigz=y
# end of Compression
#
# Disc
#
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_parted=y
# end of Disc
#
# Filesystem
#
CONFIG_PACKAGE_attr=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_BTRFS_PROGS_ZSTD=y
CONFIG_PACKAGE_chattr=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_lsattr=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_xfs-fsck=y
CONFIG_PACKAGE_xfs-mkfs=y
# end of Filesystem
#
# Shells
#
CONFIG_PACKAGE_bash=y
# end of Shells

CONFIG_PACKAGE_acpid=y
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_getopt=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_uuidgen=y

#####################################################################
# eMMC support
#####################################################################
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_cgdisk=y
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_mmc-utils=y
CONFIG_PACKAGE_sfdisk=y
CONFIG_PACKAGE_sgdisk=y

# --- Optional Packages --- #

#### EVERYTHING BELOW THIS SECTION IS OPTIONAL!!

#### You can delete or comment out with '#' any package you don't want to install.

#####################################################################
# Kernel Modules
#####################################################################
#
CONFIG_PACKAGE_kmod-thunderx-net=y
### Kernel Modules
CONFIG_PACKAGE_kmod-usb-hid=y
CONFIG_PACKAGE_kmod-usb2-pci=y
### Kernel Modules - out-of-tree driver
CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor=y

#####################################################################
# Packages Tweaks
#####################################################################
CONFIG_PACKAGE_cpufreq=y

#####################################################################
# LUCI Applications
#####################################################################
CONFIG_PACKAGE_luci-app-amlogic=y
CONFIG_PACKAGE_luci-i18n-amlogic-zh-cn=y

CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y