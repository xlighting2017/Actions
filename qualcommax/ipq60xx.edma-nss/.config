# vi: set syntax=make:

#####################################################################
# Target device
#####################################################################
# Uncomment target device you want to build for, set '=y'
CONFIG_TARGET_qualcommax_ipq60xx=y

CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

CONFIG_ATH11K_MEM_PROFILE_1G=y
CONFIG_NSS_MEM_PROFILE_MEDIUM=y

# Uncomment target device you want to build for, set '=y'
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_cmiot_ax18=y
# CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_cmiot_ax18="-luci-app-mosdns -luci-i18n-mosdns-zh-cn -mosdns -v2ray-geoip -v2ray-geosite -v2dat -geo2txt"
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y
# CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_zn_m2="-luci-app-mosdns -luci-i18n-mosdns-zh-cn -mosdns -v2ray-geoip -v2ray-geosite -v2dat -geo2txt"
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02="athena-led luci-app-athena-led luci-app-mosdns luci-i18n-mosdns-zh-cn"

#####################################################################
# Packages Tweaks
#####################################################################
# re-cs-02 missing packages
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y

#####################################################################
# LUCI Applications
#####################################################################
CONFIG_PACKAGE_athena-led=m
CONFIG_PACKAGE_luci-app-athena-led=m
# CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=m

## Sysupgrade-only images: the audience is people who already run OpenWrt, so
## no initramfs/factory install images. initramfs is default-y for this target,
## and the Asus RT-AX89X's recovery .trx caps its kernel at 16 MiB where the NSS
## initramfs kernel is ~21 MiB, so it cannot be built at all.
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

## Compiler and Toolchain Optimization
CONFIG_BINUTILS_USE_VERSION_2_46=y
CONFIG_CCACHE=y
CONFIG_DEVEL=y
CONFIG_GCC_USE_GRAPHITE=y
CONFIG_GCC_USE_VERSION_15=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53+crc+crypto"
CONFIG_TARGET_OPTIONS=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_USE_GC_SECTIONS=y
CONFIG_USE_LTO=y
CONFIG_USE_MOLD=y
CONFIG_ZLIB_OPTIMIZE_SPEED=y


## Kernel Build Options
CONFIG_BUILD_PATENTED=y
CONFIG_EXPERIMENTAL=y

# Hardening build options
CONFIG_GCC_DEFAULT_PIE=y
CONFIG_GCC_DEFAULT_SSP=y
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
CONFIG_PKG_ASLR_PIE_ALL=y
CONFIG_PKG_CC_STACKPROTECTOR_ALL=y
CONFIG_KERNEL_CC_STACKPROTECTOR_STRONG=y
CONFIG_PKG_FORTIFY_SOURCE_3=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_USE_SECCOMP=y

## Additional Packages and Utilities
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_HTOP_LMSENSORS=n
CONFIG_PACKAGE_iperf3=y
CONFIG_LIBCURL_MBEDTLS=n
CONFIG_LIBCURL_OPENSSL=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_wpad-openssl=y

## USB storage. Stock images install it from the kmods feed, which cannot
## serve this kernel, so it is built in. kmod-fs-ext4 is a target default.
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y

## TUN for Tailscale, OpenVPN and the like, for the same reason.
CONFIG_PACKAGE_kmod-tun=y

## WireGuard, for the same reason.
CONFIG_PACKAGE_kmod-wireguard=y

## Redundant Default Packages
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_luci-app-attendedsysupgrade=n
CONFIG_PACKAGE_attendedsysupgrade-common=n