CONFIG_PACKAGE_luci-app-mosdns=m
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=m
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_luci-i18n-tailscale-community-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
# end of 3. Applications

# - Statistics: Monitor your router’s performance (CPU, memory, bandwidth).
# CONFIG_PACKAGE_luci-app-statistics=y
# CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y
