# vi: set syntax=make:

#####################################################################
# Target device
#####################################################################
# Uncomment target device you want to build for, set '=y'
CONFIG_TARGET_qualcommax_ipq60xx=y

# Uncomment target device you want to build for, set '=y'
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_cmiot_ax18=y
# CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_cmiot_ax18="-luci-app-mosdns -luci-i18n-mosdns-zh-cn -mosdns -v2ray-geoip -v2ray-geosite -v2dat -geo2txt"
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y
# CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_zn_m2="-luci-app-mosdns -luci-i18n-mosdns-zh-cn -mosdns -v2ray-geoip -v2ray-geosite -v2dat -geo2txt"
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02="athena-led luci-app-athena-led luci-app-mosdns luci-i18n-mosdns-zh-cn"

#####################################################################
# Packages Tweaks
#####################################################################
# re-cs-02 missing packages
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y

#####################################################################
# LUCI Applications
#####################################################################
CONFIG_PACKAGE_athena-led=m
CONFIG_PACKAGE_luci-app-athena-led=m
# CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=m