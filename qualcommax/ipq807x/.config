# vi: set syntax=make:

#####################################################################
# Target device
#####################################################################
# Uncomment target device you want to build for, set '=y'
CONFIG_TARGET_qualcommax_ipq807x=y

# Uncomment target device you want to build for, set '=y'
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_aliyun_ap8220=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq807x_DEVICE_aliyun_ap8220="-luci-app-mosdns -luci-i18n-mosdns-zh-cn -mosdns -v2ray-geoip -v2ray-geosite -v2dat -geo2txt"

CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_qnap_301w=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq807x_DEVICE_qnap_301w="luci-app-mosdns luci-i18n-mosdns-zh-cn"

CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_redmi_ax6=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq807x_DEVICE_redmi_ax6="-luci-app-mosdns -luci-i18n-mosdns-zh-cn -mosdns -v2ray-geoip -v2ray-geosite -v2dat -geo2txt"
